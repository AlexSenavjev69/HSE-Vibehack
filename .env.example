
# Telegram: тестовый ID работает только через npm run dev на localhost.
VITE_USE_TEST_TELEGRAM_ID=true
VITE_TEST_TELEGRAM_ID=100000001
# ID Appwrite Function для Telegram / production. В локальном тесте оставьте пустым.
VITE_APPWRITE_PROFILE_FUNCTION_ID=
# Только сервер: ключ со scopes rows.read и rows.write. Не добавляйте префикс VITE_.
APPWRITE_API_KEY=
# Только сервер: токен Telegram-бота для проверки initData.
TELEGRAM_BOT_TOKEN=
